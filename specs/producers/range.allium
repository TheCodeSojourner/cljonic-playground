-- allium: 3
-- REQ-FN-013I: range is the lowercase creation surface. Deduced one-, two-,
-- and three-argument calls require one shared unqualified signed integral type.
-- Explicit range<T> accepts zero through three arguments under the existing
-- Range constructor safe-conversion rules. range<T>() is the default empty
-- range; untyped range() and unsupported arities are rejected.
-- Factory results preserve every equivalent constructor's parameter semantics,
-- finite cardinality saturation, zero-step precedence, and observation policy.

entity Range {
    supports_header_only_distribution: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    owns_its_parameters: Boolean
    does_not_own_result_storage: Boolean
    does_not_borrow_source_or_callback: Boolean
    referential_transparency: Boolean
    deduced_factory_accepts_one_two_or_three_same_type_signed_integral_arguments: Boolean
    explicit_factory_accepts_zero_through_three_safely_converted_arguments: Boolean
    typed_empty_factory_has_zero_start_zero_end_and_unit_step: Boolean
    factory_preserves_equivalent_constructor_result_type_and_behavior: Boolean
    factory_is_constexpr_noexcept_and_preserves_input_arguments: Boolean
    factory_constructs_owned_parameters_without_result_materialization: Boolean
    factory_rejects_untyped_empty_call_and_unsupported_arities: Boolean
    factory_rejects_invalid_types_conversions_and_common_type_promotion: Boolean
    rejected_factory_calls_provide_targeted_operation_diagnostics: Boolean
    default_start_is_zero: Boolean
    default_step_is_one: Boolean
    start_is_inclusive: Boolean
    end_is_exclusive: Boolean
    zero_step_produces_infinite_repetition_of_start: Boolean
    zero_step_takes_precedence_over_empty_range: Boolean
    nonzero_step_away_from_end_is_empty_range: Boolean
    equal_start_and_end_with_nonzero_step_is_empty_range: Boolean
    effective_size_is_conservative_maximum_without_traversal: Boolean
    exposes_is_finite_predicate: Boolean
    finite_range_reports_true_is_finite: Boolean
    zero_step_range_reports_false_is_finite: Boolean
    unbounded_count_is_observable_traversal_cap: Boolean
    const_traversal_terminates_at_count: Boolean
    saturating_cardinality_bounded_by_collection_maximum_element_count: Boolean
    span_arithmetic_avoids_signed_overflow: Boolean
    operator_equals_uses_producer_parameter_equality: Boolean
    equality_compares_start_end_step: Boolean
    satisfies_nothrow_stable_equality_comparable: Boolean
    contains_is_authoritative_bounded_observation_predicate: Boolean
    contains_is_member_only_predicate: Boolean
    contains_does_not_provide_positional_value_retrieval: Boolean
    generic_contains_free_function_is_excluded: Boolean
    does_not_satisfy_indexed_producer: Boolean
    contains_is_constant_time: Boolean
    satisfies_nothrow_collection_element: Boolean
    does_not_expose_callable_operator: Boolean
    get_and_lookup_are_excluded: Boolean
    -- Producer observation uses free-function operations such as count and materialization; Range::contains remains a member predicate, not a free-function overload.
    free_function_observation_is_canonical_access_path: Boolean
    start_end_step_member_accessors_are_noncanonical: Boolean
    next_preserves_endpoint_and_step: Boolean
    zero_step_next_remains_unbounded_with_same_observation_cap: Boolean
    empty_nonzero_step_next_preserves_parameters: Boolean
    singleton_nonzero_step_next_is_empty_at_endpoint_without_step_addition: Boolean
    multi_element_nonzero_step_next_advances_start_by_step: Boolean

    invariant HeaderOnlyDistribution {
        this.supports_header_only_distribution = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant OwnsItsParameters {
        this.owns_its_parameters = true
    }

    invariant DoesNotOwnResultStorage {
        this.does_not_own_result_storage = true
    }

    invariant DoesNotBorrowSourceOrCallback {
        this.does_not_borrow_source_or_callback = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant DefaultStartIsZero {
        this.default_start_is_zero = true
    }

    invariant DeducedFactoryAcceptsOneTwoOrThreeSameTypeSignedIntegralArguments {
        this.deduced_factory_accepts_one_two_or_three_same_type_signed_integral_arguments = true
    }

    invariant ExplicitFactoryAcceptsZeroThroughThreeSafelyConvertedArguments {
        this.explicit_factory_accepts_zero_through_three_safely_converted_arguments = true
    }

    invariant TypedEmptyFactoryHasZeroStartZeroEndAndUnitStep {
        this.typed_empty_factory_has_zero_start_zero_end_and_unit_step = true
    }

    invariant FactoryPreservesEquivalentConstructorResultTypeAndBehavior {
        this.factory_preserves_equivalent_constructor_result_type_and_behavior = true
    }

    invariant FactoryIsConstexprNoexceptAndPreservesInputArguments {
        this.factory_is_constexpr_noexcept_and_preserves_input_arguments = true
    }

    invariant FactoryConstructsOwnedParametersWithoutResultMaterialization {
        this.factory_constructs_owned_parameters_without_result_materialization = true
    }

    invariant FactoryRejectsUntypedEmptyCallAndUnsupportedArities {
        this.factory_rejects_untyped_empty_call_and_unsupported_arities = true
    }

    invariant FactoryRejectsInvalidTypesConversionsAndCommonTypePromotion {
        this.factory_rejects_invalid_types_conversions_and_common_type_promotion = true
    }

    invariant RejectedFactoryCallsProvideTargetedOperationDiagnostics {
        this.rejected_factory_calls_provide_targeted_operation_diagnostics = true
    }

    invariant DefaultStepIsOne {
        this.default_step_is_one = true
    }

    invariant StartIsInclusive {
        this.start_is_inclusive = true
    }

    invariant EndIsExclusive {
        this.end_is_exclusive = true
    }

    invariant ZeroStepProducesInfiniteRepetitionOfStart {
        this.zero_step_produces_infinite_repetition_of_start = true
    }

    invariant ZeroStepTakesPrecedenceOverEmptyRange {
        this.zero_step_takes_precedence_over_empty_range = true
    }

    invariant NonzeroStepAwayFromEndIsEmptyRange {
        this.nonzero_step_away_from_end_is_empty_range = true
    }

    invariant EqualStartAndEndWithNonzeroStepIsEmptyRange {
        this.equal_start_and_end_with_nonzero_step_is_empty_range = true
    }

    invariant EffectiveSizeIsConservativeMaximumWithoutTraversal {
        this.effective_size_is_conservative_maximum_without_traversal = true
    }

    invariant ExposesIsFinitePredicate {
        this.exposes_is_finite_predicate = true
    }

    invariant FiniteRangeReportsTrueIsFinite {
        this.finite_range_reports_true_is_finite = true
    }

    invariant ZeroStepRangeReportsFalseIsFinite {
        this.zero_step_range_reports_false_is_finite = true
    }

    invariant UnboundedCountIsObservableTraversalCap {
        this.unbounded_count_is_observable_traversal_cap = true
    }

    invariant ConstTraversalTerminatesAtCount {
        this.const_traversal_terminates_at_count = true
    }

    invariant SaturatingCardinalityBoundedByCollectionMaximumElementCount {
        this.saturating_cardinality_bounded_by_collection_maximum_element_count = true
    }

    invariant SpanArithmeticAvoidsSignedOverflow {
        this.span_arithmetic_avoids_signed_overflow = true
    }

    invariant OperatorEqualsUsesProducerParameterEquality {
        this.operator_equals_uses_producer_parameter_equality = true
    }

    invariant EqualityComparesStartEndStep {
        this.equality_compares_start_end_step = true
    }

    invariant SatisfiesNothrowStableEqualityComparable {
        this.satisfies_nothrow_stable_equality_comparable = true
    }

    invariant ContainsIsAuthoritativeBoundedObservationPredicate {
        this.contains_is_authoritative_bounded_observation_predicate = true
    }

    invariant ContainsIsMemberOnlyPredicate {
        this.contains_is_member_only_predicate = true
    }

    invariant ContainsDoesNotProvidePositionalValueRetrieval {
        this.contains_does_not_provide_positional_value_retrieval = true
    }

    invariant GenericContainsFreeFunctionIsExcluded {
        this.generic_contains_free_function_is_excluded = true
    }

    invariant DoesNotSatisfyIndexedProducer {
        this.does_not_satisfy_indexed_producer = true
    }

    invariant ContainsIsConstantTime {
        this.contains_is_constant_time = true
    }

    invariant DoesNotExposeCallableOperator {
        this.does_not_expose_callable_operator = true
    }

    invariant GetAndLookupAreExcluded {
        this.get_and_lookup_are_excluded = true
    }

    invariant FreeFunctionObservationIsCanonicalAccessPath {
        this.free_function_observation_is_canonical_access_path = true
    }

    invariant StartEndStepMemberAccessorsAreNoncanonical {
        this.start_end_step_member_accessors_are_noncanonical = true
    }

    invariant NextPreservesEndpointAndStep {
        this.next_preserves_endpoint_and_step = true
    }

    invariant ZeroStepNextRemainsUnboundedWithSameObservationCap {
        this.zero_step_next_remains_unbounded_with_same_observation_cap = true
    }

    invariant EmptyNonzeroStepNextPreservesParameters {
        this.empty_nonzero_step_next_preserves_parameters = true
    }

    invariant SingletonNonzeroStepNextIsEmptyAtEndpointWithoutStepAddition {
        this.singleton_nonzero_step_next_is_empty_at_endpoint_without_step_addition = true
    }

    invariant MultiElementNonzeroStepNextAdvancesStartByStep {
        this.multi_element_nonzero_step_next_advances_start_by_step = true
    }

    invariant SatisfiesNothrowCollectionElement {
        this.satisfies_nothrow_collection_element = true
    }

    invariant DefaultFormIsValid {
        this.default_constructed_form_is_valid_and_deterministic = true
    }

}

actor RangeOperator { identified_by: Range }
