-- allium: 3

entity ProducerMaterialization {
    into_requires_explicit_bounded_destination: Boolean
    into_requires_supported_collection_destination: Boolean
    into_returns_new_destination_typed_collection: Boolean
    into_vector_and_queue_append_after_destination_contents: Boolean
    into_leaves_destination_unchanged: Boolean
    into_leaves_source_unchanged: Boolean
    fits_into_is_non_throwing_non_allocating: Boolean
    fits_into_predicts_into_completeness: Boolean
    fits_into_uses_remaining_destination_capacity: Boolean
    fits_into_avoids_unsigned_addition_overflow: Boolean
    fits_into_requires_supported_collection_destination: Boolean
    unbounded_source_does_not_fit_into_destination: Boolean
    unbounded_source_materializes_bounded_prefix: Boolean
    finite_source_materializes_complete_result_when_it_fits: Boolean
    bounded_prefix_preserves_source_traversal_order: Boolean
    count_is_exact_for_materialized_collection: Boolean
    unbounded_producer_count_is_observable_traversal_cap: Boolean
    composed_producer_cardinality_uses_saturating_arithmetic: Boolean
    composed_cardinality_bounded_by_collection_maximum_element_count: Boolean
    materialization_source_domain_is_cljonic_source: Boolean
    cljonic_sources_are_directly_consumable_by_free_functions: Boolean
    into_is_explicit_owning_materialization_path: Boolean
    into_rejects_unsupported_domain_with_targeted_diagnostic: Boolean
    into_does_not_allocate_or_throw: Boolean
    materialization_rejects_producer_destinations: Boolean
    materialization_rejects_external_cpp_sources: Boolean
    into_and_fits_into_share_compatible_source_domain: Boolean
    source_reference_obeys_safe_nothrow_insertion_rules: Boolean
    map_source_requires_compatible_nominal_map_entries: Boolean
    into_set_inserts_distinct_values: Boolean
    into_map_replaces_matching_keys_with_last_value: Boolean
    into_folds_values_in_source_traversal_order: Boolean
    into_set_accepts_duplicate_values_as_noops_when_full: Boolean
    into_map_accepts_existing_key_entries_as_replacements_when_full: Boolean
    into_stops_before_first_capacity_failure_without_skipping: Boolean
    unbounded_materialization_never_exceeds_source_traversal_cap: Boolean
    finite_vector_and_queue_preflight_uses_source_count: Boolean
    finite_set_and_map_preflight_accounts_for_existing_and_prior_source_values: Boolean
    finite_set_and_map_preflight_may_evaluate_callbacks: Boolean
    into_string_normalizes_invalid_runtime_characters_and_continues: Boolean
    into_string_rejects_invalid_characters_during_constant_evaluation: Boolean
    finite_string_preflight_uses_remaining_capacity: Boolean
    fits_into_preserves_input_values: Boolean
    fits_into_and_into_do_not_share_realization_cache: Boolean
    fits_into_prediction_requires_equivalent_source_values: Boolean
    materialization_and_preflight_are_constexpr_when_supported: Boolean
    fits_into_rejects_unsupported_domain_with_targeted_diagnostic: Boolean

    invariant IntoRequiresExplicitBoundedDestination {
        this.into_requires_explicit_bounded_destination = true
    }

    -- Both operations admit Vector, Set, Map, Queue, and String destinations.
    invariant IntoRequiresSupportedCollectionDestination {
        this.into_requires_supported_collection_destination = true
    }

    invariant IntoReturnsNewDestinationTypedCollection {
        this.into_returns_new_destination_typed_collection = true
    }

    -- Queue appends at the rear, preserving the existing FIFO order.
    invariant IntoVectorAndQueueAppendAfterDestinationContents {
        this.into_vector_and_queue_append_after_destination_contents = true
    }

    invariant IntoLeavesDestinationUnchanged {
        this.into_leaves_destination_unchanged = true
    }

    invariant IntoLeavesSourceUnchanged {
        this.into_leaves_source_unchanged = true
    }

    invariant FitsIntoIsNonThrowingNonAllocating {
        this.fits_into_is_non_throwing_non_allocating = true
    }

    -- Value-sensitive preflight predicts a subsequent traversal only when it yields equivalent values.
    invariant FitsIntoPredictsIntoCompleteness {
        this.fits_into_predicts_into_completeness = true
    }

    -- Capacity measures new elements or keys, not duplicates or matching-key replacements.
    invariant FitsIntoUsesRemainingDestinationCapacity {
        this.fits_into_uses_remaining_destination_capacity = true
    }

    invariant FitsIntoAvoidsUnsignedAdditionOverflow {
        this.fits_into_avoids_unsigned_addition_overflow = true
    }

    invariant FitsIntoRequiresSupportedCollectionDestination {
        this.fits_into_requires_supported_collection_destination = true
    }

    invariant UnboundedSourceDoesNotFitIntoDestination {
        this.unbounded_source_does_not_fit_into_destination = true
    }

    invariant UnboundedSourceMaterializesBoundedPrefix {
        this.unbounded_source_materializes_bounded_prefix = true
    }

    invariant FiniteSourceMaterializesCompleteResultWhenItFits {
        this.finite_source_materializes_complete_result_when_it_fits = true
    }

    -- The processed source prefix follows traversal order; Map and Set results remain semantically unordered.
    invariant BoundedPrefixPreservesSourceTraversalOrder {
        this.bounded_prefix_preserves_source_traversal_order = true
    }

    invariant CountIsExactForMaterializedCollection {
        this.count_is_exact_for_materialized_collection = true
    }

    invariant UnboundedProducerCountIsObservableTraversalCap {
        this.unbounded_producer_count_is_observable_traversal_cap = true
    }

    invariant ComposedProducerCardinalityUsesSaturatingArithmetic {
        this.composed_producer_cardinality_uses_saturating_arithmetic = true
    }

    invariant ComposedCardinalityBoundedByCollectionMaximumElementCount {
        this.composed_cardinality_bounded_by_collection_maximum_element_count = true
    }

    invariant MaterializationSourceDomainIsCljonicSource {
        this.materialization_source_domain_is_cljonic_source = true
    }

    invariant CljonicSourcesAreDirectlyConsumableByFreeFunctions {
        this.cljonic_sources_are_directly_consumable_by_free_functions = true
    }

    invariant IntoIsExplicitOwningMaterializationPath {
        this.into_is_explicit_owning_materialization_path = true
    }

    invariant IntoRejectsUnsupportedDomainWithTargetedDiagnostic {
        this.into_rejects_unsupported_domain_with_targeted_diagnostic = true
    }

    invariant IntoDoesNotAllocateOrThrow {
        this.into_does_not_allocate_or_throw = true
    }

    invariant MaterializationRejectsProducerDestinations {
        this.materialization_rejects_producer_destinations = true
    }

    invariant MaterializationRejectsExternalCppSources {
        this.materialization_rejects_external_cpp_sources = true
    }

    invariant IntoAndFitsIntoShareCompatibleSourceDomain {
        this.into_and_fits_into_share_compatible_source_domain = true
    }

    -- Admission uses the actual traversal reference and the destination's existing insertion conversion rules.
    invariant SourceReferenceObeysSafeNothrowInsertionRules {
        this.source_reference_obeys_safe_nothrow_insertion_rules = true
    }

    -- Arbitrary pairs and alternating keys/values are not MapEntry sources.
    invariant MapSourceRequiresCompatibleNominalMapEntries {
        this.map_source_requires_compatible_nominal_map_entries = true
    }

    invariant IntoSetInsertsDistinctValues {
        this.into_set_inserts_distinct_values = true
    }

    invariant IntoMapReplacesMatchingKeysWithLastValue {
        this.into_map_replaces_matching_keys_with_last_value = true
    }

    invariant IntoFoldsValuesInSourceTraversalOrder {
        this.into_folds_values_in_source_traversal_order = true
    }

    invariant IntoSetAcceptsDuplicateValuesAsNoOpsWhenFull {
        this.into_set_accepts_duplicate_values_as_noops_when_full = true
    }

    invariant IntoMapAcceptsExistingKeyEntriesAsReplacementsWhenFull {
        this.into_map_accepts_existing_key_entries_as_replacements_when_full = true
    }

    -- Stop before the rejected insertion; never skip it to process a later duplicate or replacement.
    invariant IntoStopsBeforeFirstCapacityFailureWithoutSkipping {
        this.into_stops_before_first_capacity_failure_without_skipping = true
    }

    -- Duplicates and replacements can consume the whole observable cap without growing the destination.
    invariant UnboundedMaterializationNeverExceedsSourceTraversalCap {
        this.unbounded_materialization_never_exceeds_source_traversal_cap = true
    }

    invariant FiniteVectorAndQueuePreflightUsesSourceCount {
        this.finite_vector_and_queue_preflight_uses_source_count = true
    }

    -- String preflight counts characters only; runtime insertion normalizes invalid bytes and continues.
    invariant FiniteStringPreflightUsesRemainingCapacity {
        this.finite_string_preflight_uses_remaining_capacity = true
    }

    -- Constant evaluation preserves String's existing invalid-character rejection policy.
    invariant IntoStringRejectsInvalidCharactersDuringConstantEvaluation {
        this.into_string_rejects_invalid_characters_during_constant_evaluation = true
    }

    invariant IntoStringNormalizesInvalidRuntimeCharactersAndContinues {
        this.into_string_normalizes_invalid_runtime_characters_and_continues = true
    }

    -- Fold against existing destination values/keys and earlier source values/keys.
    -- Return false at the first capacity failure, or true after accepting the complete finite source.
    invariant FiniteSetAndMapPreflightAccountsForExistingAndPriorSourceValues {
        this.finite_set_and_map_preflight_accounts_for_existing_and_prior_source_values = true
    }

    invariant FiniteSetAndMapPreflightMayEvaluateCallbacks {
        this.finite_set_and_map_preflight_may_evaluate_callbacks = true
    }

    -- Callback effects through references or static storage may remain observable; input values are preserved.
    invariant FitsIntoPreservesInputValues {
        this.fits_into_preserves_input_values = true
    }

    invariant FitsIntoAndIntoDoNotShareRealizationCache {
        this.fits_into_and_into_do_not_share_realization_cache = true
    }

    invariant FitsIntoPredictionRequiresEquivalentSourceValues {
        this.fits_into_prediction_requires_equivalent_source_values = true
    }

    invariant MaterializationAndPreflightAreConstexprWhenSupported {
        this.materialization_and_preflight_are_constexpr_when_supported = true
    }

    invariant FitsIntoRejectsUnsupportedDomainWithTargetedDiagnostic {
        this.fits_into_rejects_unsupported_domain_with_targeted_diagnostic = true
    }

}

entity ProducerStorageAdmission {
    every_producer_is_nothrow_collection_element: Boolean
    default_constructed_producer_is_valid_and_deterministic: Boolean
    default_construction_does_not_evaluate_callbacks: Boolean
    default_construction_does_not_allocate_or_throw: Boolean
    non_default_constructible_components_reject_storage: Boolean

    invariant EveryProducerIsNothrowCollectionElement {
        this.every_producer_is_nothrow_collection_element = true
    }

    invariant DefaultConstructedProducerIsValidAndDeterministic {
        this.default_constructed_producer_is_valid_and_deterministic = true
    }

    invariant DefaultConstructionDoesNotEvaluateCallbacks {
        this.default_construction_does_not_evaluate_callbacks = true
    }

    invariant DefaultConstructionDoesNotAllocateOrThrow {
        this.default_construction_does_not_allocate_or_throw = true
    }

    invariant NonDefaultConstructibleComponentsRejectStorage {
        this.non_default_constructible_components_reject_storage = true
    }
}

entity ProducerParameterEquality {
    compares_bounded_stored_parameters_only: Boolean
    operator_equals_uses_producer_parameter_equality: Boolean
    is_o1_constexpr_noexcept_nonmutating_nonallocating: Boolean
    never_traverses_produced_sequence: Boolean
    does_not_imply_sequence_equality: Boolean
    distinct_parameters_compare_unequal_even_when_sequences_coincide: Boolean
    requires_all_stored_components_admit_stable_equality: Boolean
    callable_components_exclude_parameter_equality: Boolean
    producer_admitted_as_map_key_and_set_element: Boolean

    invariant ComparesBoundedStoredParametersOnly {
        this.compares_bounded_stored_parameters_only = true
    }

    invariant OperatorEqualsUsesProducerParameterEquality {
        this.operator_equals_uses_producer_parameter_equality = true
    }

    invariant IsO1ConstexprNoexceptNonmutatingNonallocating {
        this.is_o1_constexpr_noexcept_nonmutating_nonallocating = true
    }

    invariant NeverTraversesProducedSequence {
        this.never_traverses_produced_sequence = true
    }

    invariant DoesNotImplySequenceEquality {
        this.does_not_imply_sequence_equality = true
    }

    invariant DistinctParametersCompareUnequalEvenWhenSequencesCoincide {
        this.distinct_parameters_compare_unequal_even_when_sequences_coincide = true
    }

    invariant RequiresAllStoredComponentsAdmitStableEquality {
        this.requires_all_stored_components_admit_stable_equality = true
    }

    invariant CallableComponentsExcludeParameterEquality {
        this.callable_components_exclude_parameter_equality = true
    }

    invariant ProducerAdmittedAsMapKeyAndSetElement {
        this.producer_admitted_as_map_key_and_set_element = true
    }
}

actor ProducerMaterializationOperator { identified_by: ProducerMaterialization }
actor ProducerStorageAdmissionOperator { identified_by: ProducerStorageAdmission }
actor ProducerParameterEqualityOperator { identified_by: ProducerParameterEquality }
