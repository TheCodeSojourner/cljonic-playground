-- allium: 3

entity Cycle {
    supports_header_only_distribution: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    owns_repeated_sequence: Boolean
    does_not_own_result_storage: Boolean
    does_not_borrow_source_or_callback: Boolean
    referential_transparency: Boolean
    single_argument_form_only: Boolean
    accepts_finite_or_unbounded_sequence_source: Boolean
    source_satisfies_const_input_range: Boolean
    source_satisfies_nothrow_const_input_range: Boolean
    stores_independent_owned_source_copy: Boolean
    producer_source_copy_is_parameters_and_state: Boolean
    is_unbounded: Boolean
    exposes_count_and_is_finite: Boolean
    count_is_observable_traversal_cap: Boolean
    const_traversal_terminates_at_maximum_cap: Boolean
    repeats_source_sequence_in_order: Boolean
    finite_source_restarts_after_complete_pass: Boolean
    unbounded_source_preserves_observable_prefix: Boolean
    empty_source_produces_empty_observation: Boolean
    materializes_at_most_destination_capacity: Boolean
    does_not_fit_into_destination: Boolean
    operator_equals_uses_producer_parameter_equality: Boolean
    equality_compares_owned_source_and_form: Boolean
    provides_named_parameters_equal_operation: Boolean
    satisfies_nothrow_stable_equality_comparable: Boolean
    does_not_satisfy_indexed_producer: Boolean
    satisfies_sequenceable_producer: Boolean
    satisfies_nothrow_collection_element: Boolean
    does_not_expose_callable_operator: Boolean

    invariant HeaderOnlyDistribution {
        this.supports_header_only_distribution = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant OwnsRepeatedSequence {
        this.owns_repeated_sequence = true
    }

    invariant DoesNotOwnResultStorage {
        this.does_not_own_result_storage = true
    }

    invariant DoesNotBorrowSourceOrCallback {
        this.does_not_borrow_source_or_callback = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant SingleArgumentFormOnly {
        this.single_argument_form_only = true
    }

    invariant AcceptsFiniteOrUnboundedSequenceSource {
        this.accepts_finite_or_unbounded_sequence_source = true
    }

    invariant SourceSatisfiesConstInputRange {
        this.source_satisfies_const_input_range = true
    }

    invariant SourceSatisfiesNothrowConstInputRange {
        this.source_satisfies_nothrow_const_input_range = true
    }

    invariant StoresIndependentOwnedSourceCopy {
        this.stores_independent_owned_source_copy = true
    }

    invariant ProducerSourceCopyIsParametersAndState {
        this.producer_source_copy_is_parameters_and_state = true
    }

    invariant IsUnbounded {
        this.is_unbounded = true
    }

    invariant ExposesCountAndIsFinite {
        this.exposes_count_and_is_finite = true
    }

    invariant CountIsObservableTraversalCap {
        this.count_is_observable_traversal_cap = true
    }

    invariant ConstTraversalTerminatesAtMaximumCap {
        this.const_traversal_terminates_at_maximum_cap = true
    }

    invariant RepeatsSourceSequenceInOrder {
        this.repeats_source_sequence_in_order = true
    }

    invariant FiniteSourceRestartsAfterCompletePass {
        this.finite_source_restarts_after_complete_pass = true
    }

    invariant UnboundedSourcePreservesObservablePrefix {
        this.unbounded_source_preserves_observable_prefix = true
    }

    invariant EmptySourceProducesEmptyObservation {
        this.empty_source_produces_empty_observation = true
    }

    invariant MaterializesAtMostDestinationCapacity {
        this.materializes_at_most_destination_capacity = true
    }

    invariant DoesNotFitIntoDestination {
        this.does_not_fit_into_destination = true
    }

    invariant OperatorEqualsUsesProducerParameterEquality {
        this.operator_equals_uses_producer_parameter_equality = true
    }

    invariant EqualityComparesOwnedSourceAndForm {
        this.equality_compares_owned_source_and_form = true
    }

    invariant ProvidesNamedParametersEqualOperation {
        this.provides_named_parameters_equal_operation = true
    }

    invariant SatisfiesNothrowStableEqualityComparable {
        this.satisfies_nothrow_stable_equality_comparable = true
    }

    invariant DoesNotSatisfyIndexedProducer {
        this.does_not_satisfy_indexed_producer = true
    }

    invariant SatisfiesSequenceableProducer {
        this.satisfies_sequenceable_producer = true
    }

    invariant DoesNotExposeCallableOperator {
        this.does_not_expose_callable_operator = true
    }

    invariant SatisfiesNothrowCollectionElement {
        this.satisfies_nothrow_collection_element = true
    }

    invariant DefaultFormIsValid {
        this.default_constructed_form_is_valid_and_deterministic = true
    }
}

actor CycleOperator { identified_by: Cycle }
