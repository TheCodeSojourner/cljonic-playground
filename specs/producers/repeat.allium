-- allium: 3

entity Repeat {
    supports_header_only_distribution: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    owns_repeated_value: Boolean
    does_not_own_result_storage: Boolean
    does_not_borrow_source_or_callback: Boolean
    referential_transparency: Boolean
    uncounted_form_is_unbounded: Boolean
    counted_form_is_finite: Boolean
    zero_count_produces_empty_result: Boolean
    exposes_count_and_is_finite: Boolean
    counted_form_uses_runtime_count_for_materialization: Boolean
    counted_form_count_is_exact: Boolean
    uncounted_form_count_is_observable_traversal_cap: Boolean
    const_traversal_terminates_at_count: Boolean
    uncounted_form_materializes_at_most_destination_capacity: Boolean
    uncounted_form_does_not_fit_into_destination: Boolean
    operator_equals_uses_producer_parameter_equality: Boolean
    equality_compares_value_count_and_form: Boolean
    provides_named_parameters_equal_operation: Boolean
    satisfies_nothrow_stable_equality_comparable: Boolean
    does_not_satisfy_indexed_producer: Boolean
    satisfies_sequenceable_producer: Boolean
    satisfies_nothrow_collection_element: Boolean
    does_not_expose_callable_operator: Boolean
    get_contains_and_lookup_are_excluded: Boolean

    invariant HeaderOnlyDistribution {
        this.supports_header_only_distribution = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant OwnsRepeatedValue {
        this.owns_repeated_value = true
    }

    invariant DoesNotOwnResultStorage {
        this.does_not_own_result_storage = true
    }

    invariant DoesNotBorrowSourceOrCallback {
        this.does_not_borrow_source_or_callback = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant UncountedFormIsUnbounded {
        this.uncounted_form_is_unbounded = true
    }

    invariant CountedFormIsFinite {
        this.counted_form_is_finite = true
    }

    invariant ZeroCountProducesEmptyResult {
        this.zero_count_produces_empty_result = true
    }

    invariant ExposesCountAndIsFinite {
        this.exposes_count_and_is_finite = true
    }

    invariant CountedFormUsesRuntimeCountForMaterialization {
        this.counted_form_uses_runtime_count_for_materialization = true
    }

    invariant CountedFormCountIsExact {
        this.counted_form_count_is_exact = true
    }

    invariant UncountedFormCountIsObservableTraversalCap {
        this.uncounted_form_count_is_observable_traversal_cap = true
    }

    invariant ConstTraversalTerminatesAtCount {
        this.const_traversal_terminates_at_count = true
    }

    invariant UncountedFormMaterializesAtMostDestinationCapacity {
        this.uncounted_form_materializes_at_most_destination_capacity = true
    }

    invariant UncountedFormDoesNotFitIntoDestination {
        this.uncounted_form_does_not_fit_into_destination = true
    }

    invariant OperatorEqualsUsesProducerParameterEquality {
        this.operator_equals_uses_producer_parameter_equality = true
    }

    invariant EqualityComparesValueCountAndForm {
        this.equality_compares_value_count_and_form = true
    }

    invariant ProvidesNamedParametersEqualOperation {
        this.provides_named_parameters_equal_operation = true
    }

    invariant SatisfiesNothrowStableEqualityComparable {
        this.satisfies_nothrow_stable_equality_comparable = true
    }

    invariant DoesNotSatisfyIndexedProducer {
        this.does_not_satisfy_indexed_producer = true
    }

    invariant SatisfiesSequenceableProducer {
        this.satisfies_sequenceable_producer = true
    }

    invariant DoesNotExposeCallableOperator {
        this.does_not_expose_callable_operator = true
    }

    invariant GetContainsAndLookupAreExcluded {
        this.get_contains_and_lookup_are_excluded = true
    }

    invariant SatisfiesNothrowCollectionElement {
        this.satisfies_nothrow_collection_element = true
    }

    invariant DefaultFormIsValid {
        this.default_constructed_form_is_valid_and_deterministic = true
    }
}

actor RepeatOperator { identified_by: Repeat }