        this.sequence_independent = true
    }

    invariant DefinesValueType {
        this.defines_value_type = true
    }

    invariant DefinesCapacityPolicy {
        this.defines_capacity_policy = true
    }

    invariant RequiresConjOperation {
        this.requires_conj_operation = true
    }

    invariant RequiresCanConjPreflight {
        this.requires_can_conj_preflight = true
    }

    invariant ReturnsNewCollectionValue {
        this.returns_new_collection_value = true
    }

    invariant PreservesSource {
        this.preserves_source = true
    }

    invariant RequiresNonMutatingConjOperation {
        this.requires_non_mutating_conj_operation = true
    }

    invariant RequiresNonMutatingConjPreflight {
        this.requires_non_mutating_conj_preflight = true
    }
}

entity StableEqualityComparable {
    requires_bool_equality: Boolean
    rejects_floating_point: Boolean
    recurses_over_components: Boolean
    recurses_into_producer_parameters: Boolean
    rejects_callable_components: Boolean

    invariant RequiresBoolEquality {
        this.requires_bool_equality = true
    }

    invariant RejectsFloatingPoint {
        this.rejects_floating_point = true
    }

    invariant RecursesOverComponents {
        this.recurses_over_components = true
    }

    invariant RecursesIntoProducerParameters {
        this.recurses_into_producer_parameters = true
    }

    invariant RejectsCallableComponents {
        this.rejects_callable_components = true
    }
}

entity AlternativeStrictEquality {
    requires_same_alternative: Boolean
    rejects_cross_alternative_equality: Boolean
    rejects_cross_type_numeric_unification: Boolean

    invariant RequiresSameAlternative {
        this.requires_same_alternative = true
    }

    invariant RejectsCrossAlternativeEquality {
        this.rejects_cross_alternative_equality = true
    }

    invariant RejectsCrossTypeNumericUnification {
        this.rejects_cross_type_numeric_unification = true
    }
}

entity TotallyOrdered {
    extends_stable_equality: Boolean
    requires_strict_ordering: Boolean

    invariant ExtendsStableEquality {
        this.extends_stable_equality = true
    }

    invariant RequiresStrictOrdering {
        this.requires_strict_ordering = true
    }
}

entity NothrowEqualityComparable {
    extends_stable_equality: Boolean
    requires_nothrow_comparison: Boolean
    recurses_over_variant_alternatives: Boolean

    invariant ExtendsStableEquality {
        this.extends_stable_equality = true
    }

    invariant RequiresNothrowComparison {
        this.requires_nothrow_comparison = true
    }

    invariant RecursesOverVariantAlternatives {
        this.recurses_over_variant_alternatives = true
    }
}

entity NothrowStableEqualityComparable {
    extends_stable_equality: Boolean
    extends_nothrow_collection_element: Boolean

    invariant ExtendsStableEquality {
        this.extends_stable_equality = true
    }

    invariant ExtendsNothrowCollectionElement {
        this.extends_nothrow_collection_element = true
    }
}

entity ConceptMemberNaming {
    uses_count_member_for_cardinality: Boolean
    omits_index_bracket_lookup: Boolean
    uses_contains_predicate: Boolean

    invariant UsesCountMemberForCardinality {
        this.uses_count_member_for_cardinality = true
    }

    invariant OmitsIndexBracketLookup {
        this.omits_index_bracket_lookup = true
    }

    invariant UsesContainsPredicate {
        this.uses_contains_predicate = true
    }
}

