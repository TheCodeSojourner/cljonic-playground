    sequence_independent: Boolean
    defines_value_type: Boolean
    defines_capacity_policy: Boolean
    requires_conj_operation: Boolean
    requires_can_conj_preflight: Boolean
    returns_new_collection_value: Boolean
    preserves_source: Boolean
    requires_non_mutating_conj_operation: Boolean
    requires_non_mutating_conj_preflight: Boolean

