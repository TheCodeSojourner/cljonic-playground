actor CljonicCollectionOperator { identified_by: CljonicCollection }
actor CljonicVectorOperator { identified_by: CljonicVector }
actor CljonicMapOperator { identified_by: CljonicMap }
actor CljonicSetOperator { identified_by: CljonicSet }
actor CljonicQueueOperator { identified_by: CljonicQueue }
actor CljonicStringOperator { identified_by: CljonicString }
