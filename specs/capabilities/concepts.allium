entity SequenceableCollection {
    requires_non_throwing_count: Boolean
    layered_on_nominal_admission: Boolean

    invariant RequiresNonThrowingCount {
        this.requires_non_throwing_count = true
    }

    invariant LayeredOnNominalAdmission {
        this.layered_on_nominal_admission = true
    }
}

entity IndexedCollection {
    sequence_independent: Boolean
    refines_lookup_capability: Boolean
    requires_callable_indexed_lookup: Boolean
    requires_contains_predicate: Boolean

    invariant SequenceIndependent {
        this.sequence_independent = true
    }

    invariant RefinesLookupCapability {
        this.refines_lookup_capability = true
    }

    invariant RequiresCallableIndexedLookup {
        this.requires_callable_indexed_lookup = true
    }

    invariant RequiresContainsPredicate {
        this.requires_contains_predicate = true
    }
}

entity LookupCollection {
    sequence_independent: Boolean
    requires_lookup_type: Boolean
    requires_callable_lookup: Boolean
    requires_default_or_fallback_access: Boolean
    requires_membership_predicate: Boolean

    invariant SequenceIndependent {
        this.sequence_independent = true
    }

    invariant RequiresLookupType {
        this.requires_lookup_type = true
    }

    invariant RequiresCallableLookup {
        this.requires_callable_lookup = true
    }

    invariant RequiresDefaultOrFallbackAccess {
        this.requires_default_or_fallback_access = true
    }

    invariant RequiresMembershipPredicate {
        this.requires_membership_predicate = true
    }
}

entity AssociativeCollection {
    sequence_independent: Boolean
    defines_key_type: Boolean
    defines_value_type: Boolean
    defines_capacity_policy: Boolean
    requires_assoc_operation: Boolean
    requires_key_value_can_assoc_preflight: Boolean
    returns_new_collection_value: Boolean
    preserves_source: Boolean
    requires_non_mutating_assoc_operation: Boolean
    requires_non_mutating_assoc_preflight: Boolean

    invariant SequenceIndependent {
        this.sequence_independent = true
    }

    invariant DefinesKeyType {
        this.defines_key_type = true
    }

    invariant DefinesValueType {
        this.defines_value_type = true
    }

    invariant DefinesCapacityPolicy {
        this.defines_capacity_policy = true
    }

    invariant RequiresAssocOperation {
        this.requires_assoc_operation = true
    }

    invariant RequiresKeyValueCanAssocPreflight {
        this.requires_key_value_can_assoc_preflight = true
    }

    invariant ReturnsNewCollectionValue {
        this.returns_new_collection_value = true
    }

    invariant PreservesSource {
        this.preserves_source = true
    }

    invariant RequiresNonMutatingAssocOperation {
        this.requires_non_mutating_assoc_operation = true
    }

    invariant RequiresNonMutatingAssocPreflight {
        this.requires_non_mutating_assoc_preflight = true
    }
}

