-- allium: 3

entity CljonicCollection {
    nominal_admission_requires_cljonic_owned_trait: Boolean
    excludes_structural_similarity: Boolean
    distinguishes_collection_kind: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    referential_transparency: Boolean

    invariant NominalAdmissionRequiresCljonicOwnedTrait {
        this.nominal_admission_requires_cljonic_owned_trait = true
    }

    invariant ExcludesStructuralSimilarity {
        this.excludes_structural_similarity = true
    }

    invariant DistinguishesCollectionKind {
        this.distinguishes_collection_kind = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }
}

