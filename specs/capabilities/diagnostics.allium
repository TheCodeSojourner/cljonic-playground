-- allium: 3

-- RejectionDiagnostic (REQ-DIAG-009): the targeted compile-time diagnostic
-- fallback for public free functions, present or added later, whose supported
-- domain is closed and expressible through named capability concepts (equal,
-- not_equal, the producer factory functions repeat, cycle, iterate, and
-- repeatedly, and the collection primitives such as assoc, conj, get, and
-- contains). Primary
-- admission remains concept-based; the fallback is a diagnostic overload
-- constrained on the negation of the admission gate, one per supported arity,
-- that never returns a value and is never a supported call target. It turns a
-- list of rejected concept candidates into one message that names the
-- operation, the rejected operand types, and the violated domain rule.
--
-- This entity records the observable contract only. The message wording, the
-- instantiation-dependent static_assert mechanism, and the "never a supported
-- call target" review obligation are governance properties held in the
-- requirements (REQ-DIAG-009) and architecture (S3_rejection_diagnostic).

entity RejectionDiagnostic {
    primary_admission_remains_concept_based: Boolean
    diagnostic_overload_per_supported_arity: Boolean
    constrained_on_negation_of_admission_gate: Boolean
    detection_uses_named_concepts_not_callability: Boolean
    applies_to_equal_and_not_equal: Boolean
    applies_to_producer_factory_functions: Boolean
    applies_to_collection_primitives: Boolean

    invariant PrimaryAdmissionRemainsConceptBased {
        this.primary_admission_remains_concept_based = true
    }

    invariant DiagnosticOverloadPerSupportedArity {
        this.diagnostic_overload_per_supported_arity = true
    }

    invariant ConstrainedOnNegationOfAdmissionGate {
        this.constrained_on_negation_of_admission_gate = true
    }

    invariant DetectionUsesNamedConceptsNotCallability {
        this.detection_uses_named_concepts_not_callability = true
    }

    invariant AppliesToEqualAndNotEqual {
        this.applies_to_equal_and_not_equal = true
    }

    invariant AppliesToProducerFactoryFunctions {
        this.applies_to_producer_factory_functions = true
    }

    invariant AppliesToCollectionPrimitives {
        this.applies_to_collection_primitives = true
    }
}

actor RejectionDiagnosticOperator { identified_by: RejectionDiagnostic }

-- ClassTemplateDeductionDiagnostic (REQ-DIAG-012): the targeted
-- compile-time diagnostic for a public class template, present or added
-- later, whose type-argument domain is closed and expressible through named
-- capability concepts. The type-argument domain stays a `requires`-clause
-- constraint on that named concept, so an out-of-domain argument is still
-- rejected softly and satisfies no admission concept. An out-of-domain class
-- template argument deduction is redirected, by deduction guides constrained
-- on the negation of the domain rule and provided for every supported arity,
-- to an internal diagnostic specialization that carries exactly one targeted
-- static_assert. An admitted deduction, and every explicit construction, still
-- selects the real specialization unchanged.
--
-- This entity records the observable contract only. The message wording and the
-- instantiation-dependent static_assert mechanism are governance properties
-- held in the requirements (REQ-DIAG-012, REQ-DIAG-004) and architecture
-- (S3_class_template_deduction_diagnostic).

entity ClassTemplateDeductionDiagnostic {
    domain_gate_uses_named_capability_concept: Boolean
    out_of_domain_deduction_redirects_to_diagnostic_specialization: Boolean
    redirect_guide_provided_per_supported_arity: Boolean
    diagnostic_specialization_internal_and_unsupported: Boolean
    admitted_deduction_unchanged: Boolean
    non_deducible_type_argument_redirects_to_guidance: Boolean

    invariant DomainGateUsesNamedCapabilityConcept {
        this.domain_gate_uses_named_capability_concept = true
    }

    invariant OutOfDomainDeductionRedirectsToDiagnosticSpecialization {
        this.out_of_domain_deduction_redirects_to_diagnostic_specialization = true
    }

    invariant RedirectGuideProvidedPerSupportedArity {
        this.redirect_guide_provided_per_supported_arity = true
    }

    invariant DiagnosticSpecializationInternalAndUnsupported {
        this.diagnostic_specialization_internal_and_unsupported = true
    }

    invariant AdmittedDeductionUnchanged {
        this.admitted_deduction_unchanged = true
    }

    invariant NonDeducibleTypeArgumentRedirectsToGuidance {
        this.non_deducible_type_argument_redirects_to_guidance = true
    }
}

actor ClassTemplateDeductionDiagnosticOperator { identified_by: ClassTemplateDeductionDiagnostic }
