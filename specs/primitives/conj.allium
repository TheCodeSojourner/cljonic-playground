-- allium: 3

entity Conj {
    supports_conj_free_function: Boolean
    supports_vector_conj: Boolean
    supports_set_conj: Boolean
    supports_map_conj: Boolean
    supports_queue_conj: Boolean
    replaces_duplicate_key_or_element: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    functional_immutability_preserved: Boolean
    referential_transparency: Boolean
    copy_on_modify_semantics: Boolean

    invariant ConjFreeFunctionSupported {
        this.supports_conj_free_function = true
    }

    invariant SupportsVectorConj {
        this.supports_vector_conj = true
    }

    invariant SupportsSetConj {
        this.supports_set_conj = true
    }

    invariant SupportsMapConj {
        this.supports_map_conj = true
    }

    invariant SupportsQueueConj {
        this.supports_queue_conj = true
    }

    invariant ReplacesDuplicateKeyOrElement {
        this.replaces_duplicate_key_or_element = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant FunctionalImmutabilityPreserved {
        this.functional_immutability_preserved = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant CopyOnModifySemantics {
        this.copy_on_modify_semantics = true
    }
}

actor ConjOperator { identified_by: Conj }
