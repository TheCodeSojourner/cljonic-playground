-- allium: 3

entity Conj {
    supports_conj_free_function: Boolean
    supports_vector_conj: Boolean
    supports_set_conj: Boolean
    supports_map_conj: Boolean
    supports_queue_conj: Boolean
    supports_string_conj: Boolean
    supports_zero_value_conj: Boolean
    zero_value_conj_returns_unchanged_copy: Boolean
    supports_variadic_conj: Boolean
    variadic_folds_values_left_to_right: Boolean
    variadic_requires_at_least_two_values: Boolean
    variadic_value_admitted_under_collection_domain: Boolean
    variadic_out_of_domain_value_rejected_at_compile_time: Boolean
    variadic_over_capacity_value_is_no_op_and_continues: Boolean
    string_conj_appends_at_logical_count: Boolean
    full_string_conj_returns_unchanged_copy: Boolean
    string_conj_uses_string_character_policy: Boolean
    replaces_duplicate_key_or_element: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    functional_immutability_preserved: Boolean
    referential_transparency: Boolean
    copy_on_modify_semantics: Boolean

    invariant ConjFreeFunctionSupported {
        this.supports_conj_free_function = true
    }

    invariant SupportsVectorConj {
        this.supports_vector_conj = true
    }

    invariant SupportsSetConj {
        this.supports_set_conj = true
    }

    invariant SupportsMapConj {
        this.supports_map_conj = true
    }

    invariant SupportsQueueConj {
        this.supports_queue_conj = true
    }

    invariant SupportsStringConj {
        this.supports_string_conj = true
    }

    invariant SupportsZeroValueConj {
        this.supports_zero_value_conj = true
    }

    invariant ZeroValueConjReturnsUnchangedCopy {
        this.zero_value_conj_returns_unchanged_copy = true
    }

    invariant SupportsVariadicConj {
        this.supports_variadic_conj = true
    }

    invariant VariadicFoldsValuesLeftToRight {
        this.variadic_folds_values_left_to_right = true
    }

    invariant VariadicRequiresAtLeastTwoValues {
        this.variadic_requires_at_least_two_values = true
    }

    invariant VariadicValueAdmittedUnderCollectionDomain {
        this.variadic_value_admitted_under_collection_domain = true
    }

    invariant VariadicOutOfDomainValueRejectedAtCompileTime {
        this.variadic_out_of_domain_value_rejected_at_compile_time = true
    }

    invariant VariadicOverCapacityValueIsNoOpAndContinues {
        this.variadic_over_capacity_value_is_no_op_and_continues = true
    }

    invariant StringConjAppendsAtLogicalCount {
        this.string_conj_appends_at_logical_count = true
    }

    invariant FullStringConjReturnsUnchangedCopy {
        this.full_string_conj_returns_unchanged_copy = true
    }

    invariant StringConjUsesStringCharacterPolicy {
        this.string_conj_uses_string_character_policy = true
    }

    invariant ReplacesDuplicateKeyOrElement {
        this.replaces_duplicate_key_or_element = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant FunctionalImmutabilityPreserved {
        this.functional_immutability_preserved = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant CopyOnModifySemantics {
        this.copy_on_modify_semantics = true
    }
}

actor ConjOperator { identified_by: Conj }
