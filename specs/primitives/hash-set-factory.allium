-- allium: 3
-- REQ-FN-029F: `hash_set` is the idiomatic Set factory. Its type and
-- capacity inference follow the approved first-element and argument-count
-- rules, and Set construction semantics govern duplicates.

entity HashSetFactory {
    supports_deduced_element_factory: Boolean
    deduced_element_type_is_unqualified_first_argument: Boolean
    supports_explicit_element_type_factory: Boolean
    supports_explicit_capacity_factory: Boolean
    deduced_capacity_equals_argument_count: Boolean
    explicit_capacity_determines_result_capacity: Boolean
    explicit_capacity_factory_supports_empty_arguments: Boolean
    explicit_capacity_empty_factory_supports_zero_capacity: Boolean
    explicit_capacity_is_at_least_argument_count: Boolean
    explicit_capacity_is_bounded_by_configured_maximum: Boolean
    nonempty_forms_require_at_least_one_argument: Boolean
    empty_factory_requires_explicit_element_type_and_capacity: Boolean
    empty_factory_without_explicit_capacity_is_compile_time_rejected: Boolean
    untyped_empty_call_is_compile_time_rejected: Boolean
    argument_count_is_bounded_by_configured_maximum: Boolean
    oversized_argument_count_is_compile_time_rejected: Boolean
    element_type_satisfies_set_element_admission: Boolean
    every_argument_constructs_safely_without_throwing: Boolean
    runtime_duplicate_construction_deduplicates: Boolean
    constant_evaluated_duplicate_construction_is_rejected: Boolean
    deduced_capacity_is_argument_count_despite_deduplication: Boolean
    preserves_public_set_type_and_existing_constructors: Boolean
    returns_independently_owning_set: Boolean
    constexpr_noexcept_nonallocating: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    referential_transparency: Boolean

    invariant SupportsDeducedElementFactory {
        this.supports_deduced_element_factory = true
    }

    invariant DeducedElementTypeIsUnqualifiedFirstArgument {
        this.deduced_element_type_is_unqualified_first_argument = true
    }

    invariant SupportsExplicitElementTypeFactory {
        this.supports_explicit_element_type_factory = true
    }

    invariant SupportsExplicitCapacityFactory {
        this.supports_explicit_capacity_factory = true
    }

    invariant DeducedCapacityEqualsArgumentCount {
        this.deduced_capacity_equals_argument_count = true
    }

    invariant ExplicitCapacityDeterminesResultCapacity {
        this.explicit_capacity_determines_result_capacity = true
    }

    invariant ExplicitCapacityFactorySupportsEmptyArguments {
        this.explicit_capacity_factory_supports_empty_arguments = true
    }

    invariant ExplicitCapacityEmptyFactorySupportsZeroCapacity {
        this.explicit_capacity_empty_factory_supports_zero_capacity = true
    }

    invariant ExplicitCapacityIsAtLeastArgumentCount {
        this.explicit_capacity_is_at_least_argument_count = true
    }

    invariant ExplicitCapacityIsBoundedByConfiguredMaximum {
        this.explicit_capacity_is_bounded_by_configured_maximum = true
    }

    invariant NonemptyFormsRequireAtLeastOneArgument {
        this.nonempty_forms_require_at_least_one_argument = true
    }

    invariant EmptyFactoryRequiresExplicitElementTypeAndCapacity {
        this.empty_factory_requires_explicit_element_type_and_capacity = true
    }

    invariant EmptyFactoryWithoutExplicitCapacityIsCompileTimeRejected {
        this.empty_factory_without_explicit_capacity_is_compile_time_rejected = true
    }

    invariant UntypedEmptyCallIsCompileTimeRejected {
        this.untyped_empty_call_is_compile_time_rejected = true
    }

    invariant ArgumentCountIsBoundedByConfiguredMaximum {
        this.argument_count_is_bounded_by_configured_maximum = true
    }

    invariant OversizedArgumentCountIsCompileTimeRejected {
        this.oversized_argument_count_is_compile_time_rejected = true
    }

    invariant ElementTypeSatisfiesSetElementAdmission {
        this.element_type_satisfies_set_element_admission = true
    }

    invariant EveryArgumentConstructsSafelyWithoutThrowing {
        this.every_argument_constructs_safely_without_throwing = true
    }

    invariant RuntimeDuplicateConstructionDeduplicates {
        this.runtime_duplicate_construction_deduplicates = true
    }

    invariant ConstantEvaluatedDuplicateConstructionIsRejected {
        this.constant_evaluated_duplicate_construction_is_rejected = true
    }

    invariant DeducedCapacityIsArgumentCountDespiteDeduplication {
        this.deduced_capacity_is_argument_count_despite_deduplication = true
    }

    invariant PreservesPublicSetTypeAndExistingConstructors {
        this.preserves_public_set_type_and_existing_constructors = true
    }

    invariant ReturnsIndependentlyOwningSet {
        this.returns_independently_owning_set = true
    }

    invariant ConstexprNoexceptNonallocating {
        this.constexpr_noexcept_nonallocating = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }
}

actor HashSetFactoryOperator { identified_by: HashSetFactory }
