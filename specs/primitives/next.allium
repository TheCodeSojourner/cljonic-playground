-- allium: 3
-- REQ-FN-002A4: next(producer) is extended to Repeat in the current slice.
-- REQ-FN-013E: a finite counted Repeat tail has count max(count - 1, 0); an
-- unbounded Repeat tail remains unbounded. Results invoke no callbacks and do
-- not materialize producer results.
-- REQ-FN-002A5 and REQ-FN-013F: next(producer) also supports Range while
-- preserving its endpoint and step, including overflow-safe empty-tail cases.
-- REQ-FN-002A6 and REQ-FN-013G: next(producer) supports Cycle. Finite-source
-- cycles advance their starting offset; unbounded-source cycles tail their
-- owned source and reset the offset. Source must itself support next unless
-- it is a collection.
-- REQ-FN-002A7 and REQ-FN-013H: next(producer) supports Iterate and Repeatedly.
-- Callback-backed producers eagerly advance once when nonempty; Iterate uses
-- the advanced value as its new initial value, while Repeatedly discards one
-- generated value and retains the advanced callback state in the tail.

entity Next {
    supports_next_free_function: Boolean
    supports_sequenceable_collection_domain: Boolean
    supports_producer_tail_domain: Boolean
    producer_tail_domain_includes_range: Boolean
    producer_tail_domain_includes_cycle: Boolean
    producer_tail_domain_includes_iterate: Boolean
    producer_tail_domain_includes_repeatedly: Boolean
    returns_same_producer_kind_as_source: Boolean
    returns_elements_after_first_of_producer_result: Boolean
    unbounded_producer_tail_remains_unbounded: Boolean
    repeated_next_never_exhausts_unbounded_producer: Boolean
    producer_tail_result_is_self_contained_and_owning: Boolean
    producer_tail_does_not_materialize_producer_results: Boolean
    callback_producer_tail_invokes_one_callback_when_nonempty: Boolean
    iterate_tail_uses_advanced_value_as_initial: Boolean
    repeatedly_tail_discards_one_value_and_preserves_advanced_step_state: Boolean
    finite_repeatedly_tail_decrements_count: Boolean
    unbounded_callback_producer_tail_preserves_observation_cap: Boolean
    empty_callback_producer_tail_does_not_invoke_callback: Boolean
    producer_tail_coherent_with_count_is_finite_is_empty_into_and_fits_into: Boolean
    range_tail_preserves_endpoint_and_step: Boolean
    zero_step_range_tail_remains_unbounded_with_same_observation_cap: Boolean
    empty_nonzero_step_range_tail_preserves_parameters: Boolean
    singleton_nonzero_step_range_tail_is_empty_at_endpoint_without_step_addition: Boolean
    multi_element_nonzero_step_range_tail_advances_start_by_step: Boolean
    finite_cycle_tail_advances_starting_offset_modulo_observed_source_count: Boolean
    empty_finite_cycle_tail_preserves_empty_observation: Boolean
    unbounded_cycle_tail_advances_source_and_resets_starting_offset: Boolean
    returns_same_collection_kind_as_source: Boolean
    returns_elements_after_first: Boolean
    result_capacity_is_source_capacity_minus_one_saturating_at_zero: Boolean
    empty_or_singleton_returns_empty_result: Boolean
    map_entries_remain_value_semantic: Boolean
    map_set_order_is_not_semantically_significant: Boolean
    queue_preserves_fifo_order: Boolean
    preserves_input: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    constexpr_capable: Boolean
    rejects_unsupported_domain_with_targeted_diagnostic: Boolean
    diagnostic_names_supported_domains: Boolean

    invariant NextFreeFunctionSupported {
        this.supports_next_free_function = true
    }

    invariant SupportsSequenceableCollectionDomain {
        this.supports_sequenceable_collection_domain = true
    }

    invariant ReturnsSameCollectionKindAsSource {
        this.returns_same_collection_kind_as_source = true
    }

    invariant ReturnsElementsAfterFirst {
        this.returns_elements_after_first = true
    }

    invariant ResultCapacityIsSourceCapacityMinusOneSaturatingAtZero {
        this.result_capacity_is_source_capacity_minus_one_saturating_at_zero = true
    }

    invariant EmptyOrSingletonReturnsEmptyResult {
        this.empty_or_singleton_returns_empty_result = true
    }

    invariant MapEntriesRemainValueSemantic {
        this.map_entries_remain_value_semantic = true
    }

    invariant MapSetOrderIsNotSemanticallySignificant {
        this.map_set_order_is_not_semantically_significant = true
    }

    invariant QueuePreservesFifoOrder {
        this.queue_preserves_fifo_order = true
    }

    invariant PreservesInput {
        this.preserves_input = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant ConstexprCapable {
        this.constexpr_capable = true
    }

    invariant SupportsProducerTailDomain {
        this.supports_producer_tail_domain = true
    }

    invariant ProducerTailDomainIncludesRange {
        this.producer_tail_domain_includes_range = true
    }

    invariant ProducerTailDomainIncludesCycle {
        this.producer_tail_domain_includes_cycle = true
    }

    invariant ProducerTailDomainIncludesIterate {
        this.producer_tail_domain_includes_iterate = true
    }

    invariant ProducerTailDomainIncludesRepeatedly {
        this.producer_tail_domain_includes_repeatedly = true
    }

    invariant ReturnsSameProducerKindAsSource {
        this.returns_same_producer_kind_as_source = true
    }

    invariant ReturnsElementsAfterFirstOfProducerResult {
        this.returns_elements_after_first_of_producer_result = true
    }

    invariant UnboundedProducerTailRemainsUnbounded {
        this.unbounded_producer_tail_remains_unbounded = true
    }

    invariant RepeatedNextNeverExhaustsUnboundedProducer {
        this.repeated_next_never_exhausts_unbounded_producer = true
    }

    invariant ProducerTailResultIsSelfContainedAndOwning {
        this.producer_tail_result_is_self_contained_and_owning = true
    }

    invariant ProducerTailDoesNotMaterializeProducerResults {
        this.producer_tail_does_not_materialize_producer_results = true
    }

    invariant CallbackProducerTailInvokesOneCallbackWhenNonempty {
        this.callback_producer_tail_invokes_one_callback_when_nonempty = true
    }

    invariant IterateTailUsesAdvancedValueAsInitial {
        this.iterate_tail_uses_advanced_value_as_initial = true
    }

    invariant RepeatedlyTailDiscardsOneValueAndPreservesAdvancedStepState {
        this.repeatedly_tail_discards_one_value_and_preserves_advanced_step_state = true
    }

    invariant FiniteRepeatedlyTailDecrementsCount {
        this.finite_repeatedly_tail_decrements_count = true
    }

    invariant UnboundedCallbackProducerTailPreservesObservationCap {
        this.unbounded_callback_producer_tail_preserves_observation_cap = true
    }

    invariant EmptyCallbackProducerTailDoesNotInvokeCallback {
        this.empty_callback_producer_tail_does_not_invoke_callback = true
    }

    invariant ProducerTailCoherentWithCountIsFiniteIsEmptyIntoAndFitsInto {
        this.producer_tail_coherent_with_count_is_finite_is_empty_into_and_fits_into = true
    }

    invariant RangeTailPreservesEndpointAndStep {
        this.range_tail_preserves_endpoint_and_step = true
    }

    invariant ZeroStepRangeTailRemainsUnboundedWithSameObservationCap {
        this.zero_step_range_tail_remains_unbounded_with_same_observation_cap = true
    }

    invariant EmptyNonzeroStepRangeTailPreservesParameters {
        this.empty_nonzero_step_range_tail_preserves_parameters = true
    }

    invariant SingletonNonzeroStepRangeTailIsEmptyAtEndpointWithoutStepAddition {
        this.singleton_nonzero_step_range_tail_is_empty_at_endpoint_without_step_addition = true
    }

    invariant MultiElementNonzeroStepRangeTailAdvancesStartByStep {
        this.multi_element_nonzero_step_range_tail_advances_start_by_step = true
    }

    invariant FiniteCycleTailAdvancesStartingOffsetModuloObservedSourceCount {
        this.finite_cycle_tail_advances_starting_offset_modulo_observed_source_count = true
    }

    invariant EmptyFiniteCycleTailPreservesEmptyObservation {
        this.empty_finite_cycle_tail_preserves_empty_observation = true
    }

    invariant UnboundedCycleTailAdvancesSourceAndResetsStartingOffset {
        this.unbounded_cycle_tail_advances_source_and_resets_starting_offset = true
    }

    invariant RejectsUnsupportedDomainWithTargetedDiagnostic {
        this.rejects_unsupported_domain_with_targeted_diagnostic = true
    }

    invariant DiagnosticNamesSupportedDomains {
        this.diagnostic_names_supported_domains = true
    }
}

actor NextOperator { identified_by: Next }
