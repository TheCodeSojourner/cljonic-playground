-- allium: 3

entity Get {
    supports_get_free_function: Boolean
    admits_lookup_or_indexed_collections: Boolean
    preserves_collection_lookup_result_type: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    referential_transparency: Boolean
    supports_default_fallback: Boolean
    admits_only_safe_fallback_conversion: Boolean
    rejects_unsupported_calls_with_targeted_diagnostic: Boolean

    invariant GetFreeFunctionSupported {
        this.supports_get_free_function = true
    }

    invariant AdmitsLookupOrIndexedCollections {
        this.admits_lookup_or_indexed_collections = true
    }

    invariant PreservesCollectionLookupResultType {
        this.preserves_collection_lookup_result_type = true
    }

    invariant SupportsDefaultFallback {
        this.supports_default_fallback = true
    }

    invariant AdmitsOnlySafeFallbackConversion {
        this.admits_only_safe_fallback_conversion = true
    }

    invariant RejectsUnsupportedCallsWithTargetedDiagnostic {
        this.rejects_unsupported_calls_with_targeted_diagnostic = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }
}

actor GetOperator { identified_by: Get }