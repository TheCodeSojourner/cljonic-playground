-- allium: 3

entity CanConj {
    supports_can_conj_preflight: Boolean
    applies_to_all_conjable_collections: Boolean
    set_or_map_existing_element_succeeds: Boolean
    vector_or_queue_is_capacity_only: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    referential_transparency: Boolean

    invariant CanConjPreflightSupported {
        this.supports_can_conj_preflight = true
    }

    invariant AppliesToAllConjableCollections {
        this.applies_to_all_conjable_collections = true
    }

    invariant SetOrMapExistingElementSucceeds {
        this.set_or_map_existing_element_succeeds = true
    }

    invariant VectorOrQueueIsCapacityOnly {
        this.vector_or_queue_is_capacity_only = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }
}

actor CanConjOperator { identified_by: CanConj }
