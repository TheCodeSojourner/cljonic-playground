-- allium: 3

entity Contains {
    supports_contains_free_function: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    referential_transparency: Boolean
    returns_boolean_membership: Boolean
    tests_applicable_lookup_or_indexed_domain: Boolean
    supports_map_and_set_declared_lookup_types_only: Boolean
    supports_vector_and_string_integral_indices: Boolean
    excludes_range_free_function: Boolean

    invariant ContainsFreeFunctionSupported {
        this.supports_contains_free_function = true
    }

    invariant ReturnsBooleanMembership {
        this.returns_boolean_membership = true
    }

    invariant TestsApplicableLookupOrIndexedDomain {
        this.tests_applicable_lookup_or_indexed_domain = true
    }

    invariant SupportsMapAndSetDeclaredLookupTypesOnly {
        this.supports_map_and_set_declared_lookup_types_only = true
    }

    invariant SupportsVectorAndStringIntegralIndices {
        this.supports_vector_and_string_integral_indices = true
    }

    invariant ExcludesRangeFreeFunction {
        this.excludes_range_free_function = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant ContainsDoesNotPerformDefaultReturningAccess {
        this.contains_does_not_perform_default_returning_access = true
    }
}

actor ContainsOperator { identified_by: Contains }