-- allium: 3

entity OperationsProfile {
    release_state: draft | ready | rejected
    programming_language_version: String
    paradigm_preference: String
    test_framework: String
    build_system: String
    package_manager: String
    ci_cd: String
    deployment_method: String
    linter_formatter: String
    static_analysis: String
    docs_toolchain: String

    transitions release_state {
        draft -> ready
        draft -> rejected
        terminal: ready, rejected
    }

    invariant ReadyRequiresCpp26 {
        this.release_state = ready implies this.programming_language_version = "C++26"
    }

    invariant ReadyRequiresFpOrientation {
        this.release_state = ready implies this.paradigm_preference = "FP_oriented"
    }

    invariant ReadyRequiresCatch2 {
        this.release_state = ready implies this.test_framework = "Catch2_v3"
    }

    invariant ReadyRequiresCMake {
        this.release_state = ready implies this.build_system = "CMake"
    }

    invariant ReadyRequiresNoVendoredPackageManager {
        this.release_state = ready implies this.package_manager = "none_vendored_only"
    }

    invariant ReadyRequiresLocalMakefileWorkflow {
        this.release_state = ready implies this.ci_cd = "local_makefile_target_workflow"
    }

    invariant ReadyRequiresSingleHeaderDelivery {
        this.release_state = ready implies this.deployment_method = "single_amalgamated_header_release_artifact"
    }

    invariant ReadyRequiresDeterministicQualityTooling {
        this.release_state = ready implies this.linter_formatter = "clang_tidy_and_clang_format"
    }

    invariant ReadyRequiresStaticAnalysisTooling {
        this.release_state = ready implies this.static_analysis = "cppcheck_and_include_what_you_use"
    }

    invariant ReadyRequiresDocsToolchain {
        this.release_state = ready implies this.docs_toolchain = "doxygen_html_site"
    }
}

rule MarkOperationsProfileReady {
    when: EvaluateOperationsProfile(profile)
    requires: profile.release_state = draft
    requires: profile.programming_language_version = "C++26"
    requires: profile.paradigm_preference = "FP_oriented"
    requires: profile.test_framework = "Catch2_v3"
    requires: profile.build_system = "CMake"
    requires: profile.package_manager = "none_vendored_only"
    requires: profile.ci_cd = "local_makefile_target_workflow"
    requires: profile.deployment_method = "single_amalgamated_header_release_artifact"
    requires: profile.linter_formatter = "clang_tidy_and_clang_format"
    requires: profile.static_analysis = "cppcheck_and_include_what_you_use"
    requires: profile.docs_toolchain = "doxygen_html_site"
    ensures: profile.release_state = ready
}

rule RejectOperationsProfileOnLanguageDrift {
    when: EvaluateOperationsProfile(profile)
    requires: profile.release_state = draft
    requires: profile.programming_language_version != "C++26"
    ensures: profile.release_state = rejected
}

rule RejectOperationsProfileOnParadigmDrift {
    when: EvaluateOperationsProfile(profile)
    requires: profile.release_state = draft
    requires: profile.paradigm_preference != "FP_oriented"
    ensures: profile.release_state = rejected
}

rule RejectOperationsProfileOnToolchainDrift {
    when: EvaluateOperationsProfile(profile)
    requires: profile.release_state = draft
    requires: profile.build_system != "CMake"
    ensures: profile.release_state = rejected
}

actor OperationsOperator { identified_by: OperationsProfile where operations_profile.release_state = draft }

surface OperationsGovernance {
    facing operator: OperationsOperator
    context profile: OperationsProfile where profile = operator

    provides:
        EvaluateOperationsProfile(profile)
}
