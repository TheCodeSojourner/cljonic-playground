-- allium: 3
-- The owning pair and named key/value fields are active. Semantic first is
-- active; key, val, and last free functions and fixed two-element sequence
-- behavior remain deferred; this does not defer MapEntry storage or
-- named-field observation.

entity MapEntry {
    key_value_count: Integer
    supports_header_only_distribution: Boolean
    supports_static_or_automatic_storage: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    single_threaded_execution_model: Boolean
    immutable_public_api: Boolean
    referential_transparency: Boolean
    requires_value_semantic_elements: Boolean
    requires_nothrow_collection_element_key_and_value_admission: Boolean
    requires_nothrow_default_construction: Boolean
    requires_nothrow_copy_construction: Boolean
    requires_nothrow_copy_assignment: Boolean
    requires_nothrow_destruction: Boolean
    supports_named_key_field_observation: Boolean
    supports_named_value_field_observation: Boolean
    supports_first_free_function: Boolean
    semantic_key_val_last_free_functions_are_deferred: Boolean
    fixed_two_element_sequence_behavior_is_declared: Boolean
    first_returns_key: Boolean
    value_access_returns_value: Boolean
    count_is_two: Boolean
    seq_rejects_map_entry_input: Boolean

    invariant KeyValueCountIsTwo {
        this.key_value_count = 2
    }

    invariant HeaderOnlyDistribution {
        this.supports_header_only_distribution = true
    }

    invariant StaticOrAutomaticStorageOnly {
        this.supports_static_or_automatic_storage = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant SingleThreadedExecutionModel {
        this.single_threaded_execution_model = true
    }

    invariant ImmutablePublicApi {
        this.immutable_public_api = true
    }

    invariant ReferentialTransparency {
        this.referential_transparency = true
    }

    invariant RequiresValueSemanticElements {
        this.requires_value_semantic_elements = true
    }

    invariant RequiresNothrowCollectionElementKeyAndValueAdmission {
        this.requires_nothrow_collection_element_key_and_value_admission = true
    }

    invariant RequiresNothrowDefaultConstruction {
        this.requires_nothrow_default_construction = true
    }

    invariant RequiresNothrowCopyConstruction {
        this.requires_nothrow_copy_construction = true
    }

    invariant RequiresNothrowCopyAssignment {
        this.requires_nothrow_copy_assignment = true
    }

    invariant RequiresNothrowDestruction {
        this.requires_nothrow_destruction = true
    }

    invariant SupportsNamedKeyFieldObservation {
        this.supports_named_key_field_observation = true
    }

    invariant SupportsNamedValueFieldObservation {
        this.supports_named_value_field_observation = true
    }

    invariant SupportsFirstFreeFunction {
        this.supports_first_free_function = true
    }

    invariant SemanticKeyValLastFreeFunctionsAreDeferred {
        this.semantic_key_val_last_free_functions_are_deferred = true
    }

    invariant FixedTwoElementSequenceBehaviorIsDeclared {
        this.fixed_two_element_sequence_behavior_is_declared = true
    }

    invariant FirstReturnsKey {
        this.first_returns_key = true
    }

    invariant ValueAccessReturnsValue {
        this.value_access_returns_value = true
    }

    invariant CountIsTwo {
        this.count_is_two = true
    }

    invariant SeqRejectsMapEntryInput {
        this.seq_rejects_map_entry_input = true
    }
}

actor MapEntryOperator { identified_by: MapEntry }
