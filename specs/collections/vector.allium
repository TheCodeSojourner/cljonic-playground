-- allium: 3

entity VectorCollection {
    collection_state: unclassified | empty | populated | at_capacity
    capacity_limit: Integer
    logical_size: Integer

    transitions collection_state {
        unclassified -> empty
        unclassified -> populated
        unclassified -> at_capacity
    }

    invariant CapacityIsNonNegative {
        this.capacity_limit >= 0
    }

    invariant LogicalSizeIsNonNegative {
        this.logical_size >= 0
    }

    invariant LogicalSizeDoesNotExceedCapacity {
        this.logical_size <= this.capacity_limit
    }

    invariant EmptyStateMeansZeroSize {
        this.collection_state = empty implies this.logical_size = 0
    }

    invariant PopulatedStateMeansPositiveAndNotAtCapacity {
        this.collection_state = populated implies this.logical_size > 0 and this.logical_size < this.capacity_limit
    }

    invariant AtCapacityStateMeansSizeEqualsCapacity {
        this.collection_state = at_capacity implies this.logical_size = this.capacity_limit
    }
}

rule ClassifyVectorAsEmpty {
    when: ObserveVector(vector)
    requires: vector.collection_state = unclassified
    requires: vector.logical_size = 0
    requires: vector.capacity_limit >= 0
    ensures: vector.collection_state = empty
}

rule ClassifyVectorAsPopulated {
    when: ObserveVector(vector)
    requires: vector.collection_state = unclassified
    requires: vector.logical_size > 0
    requires: vector.logical_size < vector.capacity_limit
    ensures: vector.collection_state = populated
}

rule ClassifyVectorAsAtCapacity {
    when: ObserveVector(vector)
    requires: vector.collection_state = unclassified
    requires: vector.logical_size > 0
    requires: vector.logical_size = vector.capacity_limit
    ensures: vector.collection_state = at_capacity
}

actor VectorObserver { identified_by: VectorCollection where vector_collection.collection_state = unclassified }

surface VectorClassificationSurface {
    facing observer: VectorObserver
    context vector: VectorCollection where vector = observer

    provides:
        ObserveVector(vector)
}

entity VectorConstruction {
    outcome: pending | succeeded | rejected_at_compile_time
    initializer_count: Integer
    capacity: Integer
}

rule ConstructVectorWithValidElementCount {
    when: ConstructVector(construction)
    requires: construction.outcome = pending
    requires: construction.initializer_count >= 0
    requires: construction.initializer_count <= construction.capacity
    ensures: construction.outcome = succeeded
}

rule RejectVectorConstructionOnOversizedElementCount {
    when: ConstructVector(construction)
    requires: construction.outcome = pending
    requires: construction.initializer_count > construction.capacity
    ensures: construction.outcome = rejected_at_compile_time
}

actor VectorBuilder { identified_by: VectorConstruction where vector_construction.outcome = pending }

surface VectorConstructionSurface {
    facing builder: VectorBuilder
    context construction: VectorConstruction where construction = builder

    provides:
        ConstructVector(construction)
}
