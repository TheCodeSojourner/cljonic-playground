-- allium: 3

use "./vector.allium" as vector

entity CountRequest {
    vector_subject: vector/VectorCollection
    count_matches_logical_size: Boolean
    empty_vector_returns_zero: Boolean
    count_result_is_non_negative: Boolean

    invariant CountRequiresVectorSubject {
        this.vector_subject != null
    }

    invariant ResolvedCountRequiresLogicalSizeMatch {
        this.count_matches_logical_size = true
    }

    invariant ResolvedCountRequiresEmptyReturnsZero {
        this.empty_vector_returns_zero = true
    }

    invariant ResolvedCountRequiresNonNegativeResult {
        this.count_result_is_non_negative = true
    }
}

rule CountVectorCardinality {
    when: Count(request)
    requires: request.count_matches_logical_size = true
    requires: request.empty_vector_returns_zero = true
    requires: request.count_result_is_non_negative = true
    ensures: request.count_matches_logical_size = true
}

actor CountOperator { identified_by: CountRequest }

surface CountSurface {
    facing operator: CountOperator
    context request: CountRequest where request = operator

    provides:
        Count(request)
}
