-- allium: 3

use "./indexed-access.allium" as indexed

entity GetAccess {
    vector_subject: indexed/IndexedAccess
    supports_default_element_access: Boolean
    supports_fallback_access: Boolean
    default_value_is_collection_default_element: Boolean
    fallback_value_replaces_default_value_only_when_invalid: Boolean
    valid_index_probe_is_authoritative_for_indexed_access: Boolean
    negative_index_is_invalid: Boolean
    access_is_non_throwing: Boolean
    access_is_non_allocating: Boolean

    invariant GetAccessRequiresIndexedVectorSubject {
        this.vector_subject != null
    }

    invariant SupportsDefaultElementAccess {
        this.supports_default_element_access = true
    }

    invariant SupportsFallbackAccess {
        this.supports_fallback_access = true
    }

    invariant DefaultValueMatchesCollectionDefaultElement {
        this.default_value_is_collection_default_element = true
    }

    invariant FallbackValueReplacesDefaultValueOnlyWhenInvalid {
        this.fallback_value_replaces_default_value_only_when_invalid = true
    }

    invariant ValidIndexProbeIsAuthoritative {
        this.valid_index_probe_is_authoritative_for_indexed_access = true
    }

    invariant NegativeIndexIsInvalid {
        this.negative_index_is_invalid = true
    }

    invariant AccessIsNonThrowing {
        this.access_is_non_throwing = true
    }

    invariant AccessIsNonAllocating {
        this.access_is_non_allocating = true
    }
}

actor GetOperator { identified_by: GetAccess }

surface GetSurface {
    facing operator: GetOperator
    context request: GetAccess where request = operator

    provides:
        GetDefault(request)
        GetFallback(request)
        ValidIndexProbe(request)
}
