-- allium: 3

entity RangeSequence {
    start: Integer
    end: Integer
    step: Integer
    supports_default_start_zero: Boolean
    supports_default_step_one: Boolean
    default_value_type_is_int: Boolean
    supports_single_argument_form: Boolean
    supports_two_argument_form: Boolean
    supports_three_argument_form: Boolean
    inclusive_start: Boolean
    exclusive_end: Boolean
    supports_positive_step: Boolean
    supports_negative_step: Boolean
    away_from_end_step_yields_empty_range: Boolean
    equal_start_and_end_with_nonzero_step_is_empty: Boolean
    zero_step_case_is_documented_special_case: Boolean
    zero_step_is_semantically_infinite: Boolean
    semantically_infinite_forms_use_synthesis_cap: Boolean
    synthesis_cap_is_not_true_cardinality: Boolean
    materialization_never_exceeds_synthesis_cap: Boolean
    oversized_finite_forms_use_bounded_prefix: Boolean
    oversized_finite_forms_adjust_effective_exclusive_end: Boolean
    oversized_finite_forms_are_compile_time_errors_when_constant_evaluated: Boolean
    effective_size_is_authoritative_iteration_bound: Boolean
    canonical_observation_uses_free_functions: Boolean
    range_member_accessors_are_not_required: Boolean
    get_is_excluded_from_range_contract: Boolean
    valid_index_is_supported: Boolean
    valid_index_uses_effective_bounded_size: Boolean
    negative_signed_index_is_invalid: Boolean
    integral_only_bounds_and_steps: Boolean
    floating_point_bounds_and_steps_are_rejected_at_compile_time: Boolean
    producer_value_not_implicit_materialization: Boolean
    materialization_requires_explicit_bounded_destination: Boolean

    invariant DefaultStartIsZero {
        this.supports_default_start_zero = true
    }

    invariant DefaultStepIsOne {
        this.supports_default_step_one = true
    }

    invariant DefaultValueTypeIsInt {
        this.default_value_type_is_int = true
    }

    invariant SingleArgumentFormSupported {
        this.supports_single_argument_form = true
    }

    invariant TwoArgumentFormSupported {
        this.supports_two_argument_form = true
    }

    invariant ThreeArgumentFormSupported {
        this.supports_three_argument_form = true
    }

    invariant InclusiveStart {
        this.inclusive_start = true
    }

    invariant ExclusiveEnd {
        this.exclusive_end = true
    }

    invariant PositiveStepSupported {
        this.supports_positive_step = true
    }

    invariant NegativeStepSupported {
        this.supports_negative_step = true
    }

    invariant AwayFromEndStepYieldsEmptyRange {
        this.away_from_end_step_yields_empty_range = true
    }

    invariant EqualStartAndEndNonZeroStepIsEmpty {
        this.equal_start_and_end_with_nonzero_step_is_empty = true
    }

    invariant ZeroStepCaseIsDocumentedSpecialCase {
        this.zero_step_case_is_documented_special_case = true
    }

    invariant ZeroStepIsSemanticallyInfinite {
        this.zero_step_is_semantically_infinite = true
    }

    invariant SemanticallyInfiniteFormsUseSynthesisCap {
        this.semantically_infinite_forms_use_synthesis_cap = true
    }

    invariant SynthesisCapIsNotTrueCardinality {
        this.synthesis_cap_is_not_true_cardinality = true
    }

    invariant MaterializationNeverExceedsSynthesisCap {
        this.materialization_never_exceeds_synthesis_cap = true
    }

    invariant OversizedFiniteFormsUseBoundedPrefix {
        this.oversized_finite_forms_use_bounded_prefix = true
    }

    invariant OversizedFiniteFormsAreCompileTimeErrorsWhenConstantEvaluated {
        this.oversized_finite_forms_are_compile_time_errors_when_constant_evaluated = true
    }

    invariant OversizedFiniteFormsAdjustEffectiveExclusiveEnd {
        this.oversized_finite_forms_adjust_effective_exclusive_end = true
    }

    invariant EffectiveSizeIsAuthoritativeIterationBound {
        this.effective_size_is_authoritative_iteration_bound = true
    }

    invariant CanonicalObservationUsesFreeFunctions {
        this.canonical_observation_uses_free_functions = true
    }

    invariant RangeMemberAccessorsAreNotRequired {
        this.range_member_accessors_are_not_required = true
    }

    invariant GetIsExcludedFromRangeContract {
        this.get_is_excluded_from_range_contract = true
    }

    invariant ValidIndexIsSupported {
        this.valid_index_is_supported = true
    }

    invariant ValidIndexUsesEffectiveBoundedSize {
        this.valid_index_uses_effective_bounded_size = true
    }

    invariant NegativeSignedIndexIsInvalid {
        this.negative_signed_index_is_invalid = true
    }

    invariant IntegralOnlyBoundsAndSteps {
        this.integral_only_bounds_and_steps = true
    }

    invariant FloatingPointBoundsAndStepsAreRejectedAtCompileTime {
        this.floating_point_bounds_and_steps_are_rejected_at_compile_time = true
    }

    invariant ProducerValueNotImplicitMaterialization {
        this.producer_value_not_implicit_materialization = true
    }

    invariant MaterializationRequiresExplicitBoundedDestination {
        this.materialization_requires_explicit_bounded_destination = true
    }
}

actor RangeOperator { identified_by: RangeSequence }

surface RangeSurface {
    facing operator: RangeOperator
    context request: RangeSequence where request = operator

    provides:
        Range(request)
        Count(request)
        Empty(request)
        First(request)
        Next(request)
        Rest(request)
        Seq(request)
        Take(request)
        Into(request)
        ValidIndex(request)
}
