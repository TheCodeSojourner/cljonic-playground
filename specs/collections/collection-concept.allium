-- allium: 3

-- Collection Concept Specification
entity Collection {
	logical_size: Integer

	invariant LogicalSizeIsNonNegative {
		this.logical_size >= 0
	}
}

-- Bootstraps with minimal requirements: c.size() → std::size_t
-- YAGNI policy: additional requirements added when first free function needs them
-- 
-- Current state (2026-08-11):
--   - Requirement: c.size() → std::size_t
--   - No value_type requirement
--   - No operator[] requirement
--   - Future requirements: deferred until triggered by a specific free function
--
-- Implementation: cljonic-concepts.hpp::Collection

