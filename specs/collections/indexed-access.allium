-- allium: 3

use "./vector.allium" as vector

entity IndexedAccess {
    vector_subject: vector/VectorCollection
    supports_valid_index_probe: Boolean
    indexed_access_uses_logical_size: Boolean
    negative_integral_index_is_invalid: Boolean
    valid_index_is_non_throwing: Boolean
    valid_index_is_non_allocating: Boolean
    valid_index_does_not_inspect_element: Boolean

    invariant IndexedAccessRequiresVectorSubject {
        this.vector_subject != null
    }

    invariant SupportsValidIndexProbe {
        this.supports_valid_index_probe = true
    }

    invariant IndexedAccessUsesLogicalSize {
        this.indexed_access_uses_logical_size = true
    }

    invariant NegativeIntegralIndexIsInvalid {
        this.negative_integral_index_is_invalid = true
    }

    invariant ValidIndexIsNonThrowing {
        this.valid_index_is_non_throwing = true
    }

    invariant ValidIndexIsNonAllocating {
        this.valid_index_is_non_allocating = true
    }

    invariant ValidIndexDoesNotInspectElement {
        this.valid_index_does_not_inspect_element = true
    }
}

actor IndexedAccessOperator { identified_by: IndexedAccess }

surface IndexedAccessSurface {
    facing operator: IndexedAccessOperator
    context request: IndexedAccess where request = operator

    provides:
        ValidIndex(request)
}
