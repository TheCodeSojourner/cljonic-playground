-- allium: 3

-- First-pass behavioral contract shared by the REQ-SEQ-022 operation family.
entity CollectionShapingTraversalPolicy {
    preserves_input_values: Boolean
    callbacks_are_pure_and_non_allocating: Boolean
    termination_policy_is_declared: Boolean
    equality_and_ordering_gates_are_declared: Boolean
    nested_result_representation_is_declared: Boolean
    producer_behavior_is_declared: Boolean
    result_capacity_policy_is_declared: Boolean
    typed_absence_and_failure_policy_is_declared: Boolean
    result_status_is_declared: Boolean
    bounded_owning_results_are_preferred: Boolean
    maps_and_sets_are_semantically_unordered: Boolean
    transducers_and_hidden_lazy_sequences_are_unsupported: Boolean

    invariant InputValuesArePreserved {
        this.preserves_input_values = true
    }

    invariant CallbacksArePureAndNonAllocating {
        this.callbacks_are_pure_and_non_allocating = true
    }

    invariant TerminationPolicyIsDeclared {
        this.termination_policy_is_declared = true
    }

    invariant EqualityAndOrderingGatesAreDeclared {
        this.equality_and_ordering_gates_are_declared = true
    }

    invariant NestedResultRepresentationIsDeclared {
        this.nested_result_representation_is_declared = true
    }

    invariant ProducerBehaviorIsDeclared {
        this.producer_behavior_is_declared = true
    }

    invariant ResultCapacityPolicyIsDeclared {
        this.result_capacity_policy_is_declared = true
    }

    invariant TypedAbsenceAndFailurePolicyIsDeclared {
        this.typed_absence_and_failure_policy_is_declared = true
    }

    invariant ResultStatusIsDeclared {
        this.result_status_is_declared = true
    }

    invariant BoundedOwningResultsArePreferred {
        this.bounded_owning_results_are_preferred = true
    }

    invariant UnorderedMapAndSetSemantics {
        this.maps_and_sets_are_semantically_unordered = true
    }

    invariant NoTransducersOrHiddenLazySequences {
        this.transducers_and_hidden_lazy_sequences_are_unsupported = true
    }
}

-- Each operation is individually named for REQ-SEQ-022 traceability.
entity Take {
    minimum_arity: Integer
    maximum_arity: Integer
    preserves_inputs: Boolean
    returns_bounded_prefix_result: Boolean
    terminates_at_requested_count_or_source_end: Boolean
    result_is_explicit_bounded_producer: Boolean
    materialization_uses_caller_destination_capacity: Boolean
    capacity_is_minimum_of_count_and_source_bound: Boolean
    failure_policy_is_typed: Boolean

    invariant MinimumArityIsTwo { this.minimum_arity = 2 }
    invariant MaximumArityIsTwo { this.maximum_arity = 2 }
    invariant InputsArePreserved { this.preserves_inputs = true }
    invariant ReturnsBoundedPrefix { this.returns_bounded_prefix_result = true }
    invariant TerminationIsBounded { this.terminates_at_requested_count_or_source_end = true }
    invariant ResultIsExplicitBoundedProducer { this.result_is_explicit_bounded_producer = true }
    invariant MaterializationUsesCallerDestinationCapacity { this.materialization_uses_caller_destination_capacity = true }
    invariant CapacityIsMinimumOfCountAndSourceBound { this.capacity_is_minimum_of_count_and_source_bound = true }
    invariant FailurePolicyIsTyped { this.failure_policy_is_typed = true }
}

